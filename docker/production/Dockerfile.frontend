#syntax=docker/dockerfile:1
# Multi-stage Dockerfile for Lotus Fin Frontend SPA & Nginx Production Gateway

# Stage 1: Build Frontend Single Page App
FROM node:20-alpine AS builder
WORKDIR /app
COPY frontend/package*.json ./
RUN npm ci --no-audit --prefer-offline || npm install
COPY frontend/ ./
RUN npm run build

# Stage 2: Production Nginx Server serving SPA and proxying API
FROM nginx:alpine
LABEL maintainer="Lotus Fin Team"

# Copy custom nginx reverse-proxy configuration
COPY docker/production/nginx.conf /etc/nginx/conf.d/default.conf

# Copy compiled static frontend assets
COPY --from=builder /app/dist /usr/share/nginx/html

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]

