# ==============================================================================
# LOTUS FIN AI - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================

# Provider: 'mock' | 'openai' | 'gemini' | 'deepseek' | 'vllm'
LOTUS_AI_PROVIDER=mock
LOTUS_AI_MODEL=mock

# OpenAI & OpenAI-compatible
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# Google Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# System Parameters
LOTUS_AI_TIMEOUT_SECONDS=45
LOTUS_AI_MAX_REACT_ITERATIONS=4
