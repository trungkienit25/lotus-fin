# ==============================================================================
# LOTUS FIN AI - ENVIRONMENT CONFIGURATION TEMPLATE
# Sao chép tệp này thành .env và điền các khóa API tương ứng.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. AI PROVIDER & MODEL SELECTION
# Hỗ trợ cả 2 chuẩn đặt tên biến (LOTUS_AI_* và LOTUS_LLM_*):
# - LOTUS_AI_PROVIDER / LOTUS_LLM_PROVIDER : 'gemini' | 'openai' | 'deepseek' | 'vllm' | 'mock'
# - LOTUS_AI_MODEL / LOTUS_LLM_MODEL       : Tên model muốn sử dụng
# ------------------------------------------------------------------------------
LOTUS_AI_PROVIDER=gemini
LOTUS_LLM_PROVIDER=gemini

LOTUS_AI_MODEL=gemini-flash-latest
LOTUS_LLM_MODEL=gemini-flash-latest

# ------------------------------------------------------------------------------
# 2. GOOGLE GEMINI CONFIGURATION
# ------------------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here
LOTUS_LLM_API_KEY=your_gemini_api_key_here

# ------------------------------------------------------------------------------
# 3. OPENAI & OPENAI COMPATIBLE (DEEPSEEK, VLLM, OLLAMA)
# ------------------------------------------------------------------------------
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# DeepSeek example:
# LOTUS_AI_PROVIDER=deepseek
# OPENAI_API_KEY=your_deepseek_api_key_here
# OPENAI_MODEL=deepseek-chat
# OPENAI_BASE_URL=https://api.deepseek.com/v1

# ------------------------------------------------------------------------------
# 4. DATABASE & SYSTEM SETTINGS
# ------------------------------------------------------------------------------
DB_HOST=db
DB_PORT=3306
MYSQL_ROOT_PASSWORD=admin
MARIADB_ROOT_PASSWORD=admin

LOTUS_AI_TIMEOUT_SECONDS=45
LOTUS_AI_MAX_REACT_ITERATIONS=4
