# ==============================================================================
# LOTUS FIN AI - ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and configure the corresponding API keys and settings.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. AI PROVIDER & MODEL SELECTION
# Supports both variable naming standards (LOTUS_AI_* and LOTUS_LLM_*):
# - LOTUS_AI_PROVIDER / LOTUS_LLM_PROVIDER : 'gemini' | 'openai' | 'deepseek' | 'nvidia' | 'vllm' | 'mock'
# - LOTUS_AI_MODEL / LOTUS_LLM_MODEL       : Target model name to use
# ------------------------------------------------------------------------------
LOTUS_AI_PROVIDER=gemini
LOTUS_LLM_PROVIDER=gemini

LOTUS_AI_MODEL=gemini-flash-latest
LOTUS_LLM_MODEL=gemini-flash-latest

# ------------------------------------------------------------------------------
# 2. GOOGLE GEMINI CONFIGURATION (MULTI-KEY SUPPORT & AUTOMATIC FALLBACK)
# Provide a single key or multiple keys separated by commas ','.
# If the active key hits a rate limit (HTTP 429) or errors out, the system automatically falls back to the next key.
# ------------------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_key_1, your_gemini_key_2
LOTUS_LLM_API_KEY=your_gemini_key_1, your_gemini_key_2

# ------------------------------------------------------------------------------
# 3. OPENAI & OPENAI COMPATIBLE (DEEPSEEK, NVIDIA, VLLM, OLLAMA)
# Similar to Gemini, supports multiple comma-separated API keys for automatic failover.
# ------------------------------------------------------------------------------
OPENAI_API_KEY="sk-key1", "sk-key2"
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# DeepSeek example:
# LOTUS_AI_PROVIDER=deepseek
# OPENAI_API_KEY="sk-key1", "sk-key2"
# OPENAI_MODEL=deepseek-chat
# OPENAI_BASE_URL=https://api.deepseek.com/v1

# ------------------------------------------------------------------------------
# 4. NVIDIA NIM / INTEGRATE API KEYS (AUTOMATIC FALLBACK)
# ------------------------------------------------------------------------------
# LOTUS_AI_PROVIDER=nvidia
# NVIDIA_API_KEY="nvapi-key1", "nvapi-key2"
# NVIDIA_MODEL_NAME=z-ai/glm-5.3-flash

# ------------------------------------------------------------------------------
# 5. DATABASE & AGENT RUNTIME SETTINGS
# ------------------------------------------------------------------------------
DB_HOST=db
DB_PORT=3306
MYSQL_ROOT_PASSWORD=admin
MARIADB_ROOT_PASSWORD=admin

LOTUS_AI_TIMEOUT_SECONDS=45
LOTUS_AI_MAX_REACT_ITERATIONS=4

# ------------------------------------------------------------------------------
# 6. SMTP EMAIL ACCOUNT SETTINGS (FRAPPE OUTGOING EMAIL NOTIFICATIONS)
# Automatically provisioned into Frappe/ERPNext Email Account DocType on startup.
# ------------------------------------------------------------------------------
LOTUS_SMTP_SERVER=smtp.gmail.com
LOTUS_SMTP_PORT=587
LOTUS_SMTP_EMAIL=your_email@gmail.com
LOTUS_SMTP_PASSWORD=your_app_password
LOTUS_SMTP_USE_TLS=1
