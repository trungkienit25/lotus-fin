# ==============================================================================
# LOTUS FIN AI - ENVIRONMENT CONFIGURATION TEMPLATE
# Sao chép tệp này thành .env và cấu hình các biến phù hợp với môi trường của bạn.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CẤU HÌNH NHÀ CUNG CẤP AI (AI PROVIDER CONFIGURATION)
# Các giá trị hợp lệ cho LOTUS_AI_PROVIDER:
# - 'mock'     : Chế độ giả lập nội bộ (0 chi phí, không cần API Key, dùng cho Unit Tests)
# - 'openai'   : OpenAI GPT Models (GPT-4o, GPT-4o-mini, v.v.)
# - 'gemini'   : Google Gemini Models (gemini-3.8-flash, gemini-2.0-flash, v.v.)
# - 'deepseek' : DeepSeek V3 / R1 (qua OpenAI Compatible Endpoint)
# - 'vllm'     : Tự host model qua vLLM / Ollama
# ------------------------------------------------------------------------------
LOTUS_AI_PROVIDER=mock
LOTUS_AI_MODEL=mock

# ------------------------------------------------------------------------------
# 2. OPENAI & OPENAI COMPATIBLE (DEEPSEEK, OLLAMA, VLLM)
# ------------------------------------------------------------------------------
# Cấu hình khi dùng OpenAI:
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# Cấu hình khi dùng DeepSeek:
# LOTUS_AI_PROVIDER=deepseek
# OPENAI_API_KEY=your_deepseek_api_key_here
# OPENAI_MODEL=deepseek-chat
# OPENAI_BASE_URL=https://api.deepseek.com/v1

# Cấu hình khi dùng Ollama / Local vLLM:
# LOTUS_AI_PROVIDER=vllm
# OPENAI_API_KEY=ollama
# OPENAI_MODEL=qwen2.5:14b
# OPENAI_BASE_URL=http://localhost:11434/v1

# ------------------------------------------------------------------------------
# 3. GOOGLE GEMINI CONFIGURATION
# ------------------------------------------------------------------------------
# Cấu hình khi dùng Google Gemini:
# LOTUS_AI_PROVIDER=gemini
GEMINI_API_KEY=your_google_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash

# ------------------------------------------------------------------------------
# 4. GENERAL SYSTEM & TIMEOUT CONFIGURATION
# ------------------------------------------------------------------------------
# Thời gian timeout tối đa cho mỗi lượt gọi LLM (giây)
LOTUS_AI_TIMEOUT_SECONDS=45

# Giới hạn số bước suy luận tối đa trong vòng lặp ReAct Loop (mặc định 4)
LOTUS_AI_MAX_REACT_ITERATIONS=4
