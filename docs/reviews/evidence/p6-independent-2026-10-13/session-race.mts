import {fetchServerSession,markSessionRevoked,getSessionScope,markSessionVerified,subscribeSessionScope} from '../../../../frontend/src/providers/sessionScope.ts';
let resolve!: (r:Response)=>void;
globalThis.fetch=()=>new Promise<Response>(r=>{resolve=r;});
const pending=fetchServerSession();
markSessionRevoked();
resolve(new Response(JSON.stringify({user:'alice',csrf_token:'old-session'}),{status:200}));
await pending;
console.log(JSON.stringify({case:'late-bootstrap-after-revoke',expected:'REVOKED',actual:getSessionScope().state,actor:getSessionScope().actor}));
let tick:()=>void=()=>{}; let calls=0;
globalThis.window={location:{origin:'http://localhost'},addEventListener(){}} as any;
globalThis.document={hidden:false,cookie:'user_id=alice',addEventListener(){}} as any;
globalThis.setInterval=((fn:any)=>{tick=fn;return 1;}) as any;
globalThis.clearInterval=(()=>{}) as any;
globalThis.fetch=async()=>{calls++;return new Response(JSON.stringify({user:'alice',csrf_token:'rotated'}),{status:200});};
await markSessionVerified('alice','old-session');
const unsub=subscribeSessionScope(()=>{});
for(let i=0;i<100;i++)tick();
await new Promise(r=>setTimeout(r,10));
console.log(JSON.stringify({case:'same-user-active-poll',expected:'server-revalidation',actual_fetches:calls,actual:getSessionScope().state}));
unsub();
